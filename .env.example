# Copier en .env (jamais versionné) puis adapter.

# Port local de l'application web
WEB_PORT=3000

# --- Correction IA (phase 4) : la clé n'est lue que par le serveur ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Plafond mensuel par utilisateur, en euros
AI_MONTHLY_BUDGET_EUR=5
# Tarifs Batch en euros par million de tokens : À RENSEIGNER depuis la grille tarifaire officielle
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_CACHE_READ_PER_MTOK=
AI_PRICE_CACHE_WRITE_PER_MTOK=

# --- Dépôt des copies (limites à confirmer avec la documentation de l'API Claude) ---
MAX_PDF_MB=32
MAX_PDF_PAGES=100
